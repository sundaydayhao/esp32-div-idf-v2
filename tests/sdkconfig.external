# Compile-only coverage of hardware options; do not flash this onto the default wiring.
CONFIG_DIV_IR_ENABLED=y
CONFIG_DIV_GPIO2_BATTERY=y
CONFIG_DIV_GPS_ENABLED=y
CONFIG_DIV_GPS_RX=40
CONFIG_DIV_GPS_TX=-1
CONFIG_DIV_GPS_BAUD=9600
CONFIG_DIV_PN532_ENABLED=y
CONFIG_DIV_SERIAL_ENABLED=y
CONFIG_DIV_SERIAL_RX=41
CONFIG_DIV_SERIAL_TX=42
CONFIG_DIV_ROTATION=1
